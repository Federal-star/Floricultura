{
  "name": "floricultura",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestão para floricultura",
  "main": "server/server.js",
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "prisma:generate": "npx prisma generate --schema server/prisma/schema.prisma",
    "migrate:dev": "npx prisma migrate dev --schema server/prisma/schema.prisma",
    "migrate:deploy": "npx prisma migrate deploy --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
