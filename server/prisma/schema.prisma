generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
}

enum CategoriaProduto {
  PLANTA
  VASO
  INSUMO
  ARRANJO
  OUTROS
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

enum StatusPedido {
  CONCLUIDO
  CANCELADO
}

enum MotivoPerda {
  DETERIORACAO
  AVARIA
  PRAGA
  VALIDADE
  OUTROS
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  ativo     Boolean  @default(true)
  role      Role     @default(VENDEDOR)
  pedidos   Pedido[]
  perdas    Perda[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produto {
  id                 String           @id @default(cuid())
  nome               String
  sku                String           @unique
  categoria          CategoriaProduto
  precoVenda         Decimal          @db.Decimal(10, 2)
  quantidadeEstoque  Int              @default(0)
  descricao          String?
  imagemUrl          String?
  rega               String?
  iluminacao         String?
  cuidados           String?
  ativo              Boolean          @default(true)
  itensPedido        ItemPedido[]
  perdas             Perda[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Pedido {
  id              String         @id @default(uuid()) @db.Uuid
  usuarioId       String
  valorTotal      Decimal        @db.Decimal(10, 2)
  desconto        Decimal        @default(0) @db.Decimal(10, 2)
  formaPagamento  FormaPagamento
  status          StatusPedido   @default(CONCLUIDO)
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  itens           ItemPedido[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ItemPedido {
  id             String   @id @default(uuid()) @db.Uuid
  pedidoId       String   @db.Uuid
  produtoId      String
  quantidade     Int
  precoUnitario  Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto        Produto  @relation(fields: [produtoId], references: [id])
}

model Perda {
  id          String      @id @default(cuid())
  produtoId   String
  usuarioId   String
  quantidade  Int
  motivo      MotivoPerda
  observacao  String?
  produto     Produto     @relation(fields: [produtoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime    @default(now())
}
